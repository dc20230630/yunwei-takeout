<!-- pages/orderDetail/orderDetail.wxml -->
<view class="custom-navbar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
  <view class="custom-navbar-back" bindtap="goBack">
    <view class="custom-navbar-back-icon"></view>
  </view>
  <view class="custom-navbar-title">订单详情</view>
</view>
<view style="height: {{totalNavHeight}}px;"></view>

<view class="detail-container" wx:if="{{order}}">
  <scroll-view scroll-y class="detail-scroll hide-scroll">
    <view class="map-box-wrap">
      <view class="map-box">
        <view class="map-tip">
          <view class="map-tip-title">{{order.status}}</view>
          <view class="map-tip-desc">{{order.statusDescription}}</view>
        </view>
      </view>
    </view>

    <view class="detail-content">
      <view class="checkout-card food-card card">
        <view class="card-title">商品明细</view>
        <view class="food-list">
          <view class="food-item" wx:for="{{order.items}}" wx:key="id">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="food-img" />
            <view wx:else class="food-img"></view>
            <view class="food-info">
              <view class="food-name">{{item.name}}</view>
              <view class="food-specs" wx:if="{{item.specs}}">{{item.specs}}</view>
              <view class="food-qty">×{{item.number}}</view>
            </view>
            <view class="food-price-sub">¥{{item.amount * item.number}}</view>
          </view>
        </view>

        <view class="bill-breakdown">
          <view class="bill-line final-line">
            <text class="final-label">实付金额</text>
            <text class="final-val">¥{{order.total}}</text>
          </view>
        </view>
      </view>

      <view class="info-card card">
        <view class="card-title">配送信息</view>
        <view class="info-list">
          <view class="info-row">
            <text class="info-label">收货人</text>
            <text class="info-val">{{order.consignee}} {{order.phone}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">送达地址</text>
            <text class="info-val">{{order.address}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">配送方式</text>
            <text class="info-val">{{order.deliveryText}}</text>
          </view>
          <view class="info-row" wx:if="{{order.remark}}">
            <text class="info-label">订单备注</text>
            <text class="info-val">{{order.remark}}</text>
          </view>
          <view class="info-row" wx:if="{{order.cancelReason}}">
            <text class="info-label">取消原因</text>
            <text class="info-val">{{order.cancelReason}}</text>
          </view>
        </view>
      </view>

      <view class="info-card card" style="margin-bottom: 80rpx;">
        <view class="card-title">订单信息</view>
        <view class="info-list">
          <view class="info-row">
            <text class="info-label">订单编号</text>
            <view class="info-val copy-wrap">
              <text class="order-id-txt">{{order.number}}</text>
              <button class="copy-btn" bindtap="copyOrderId">复制</button>
            </view>
          </view>
          <view class="info-row">
            <text class="info-label">下单时间</text>
            <text class="info-val">{{order.orderTime}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">支付方式</text>
            <text class="info-val">{{order.payMethod === 1 ? '微信支付' : '支付宝支付'}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
